{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate config for prule Node/TypeScript projects.",
  "extends": ["github>prule/renovate-config", "group:vite"],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "Automerge minor/patch updates and pinned versions for devDependencies. Majors still come up for review.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin"],
      "automerge": true
    },
    {
      "description": "Group Serenity/JS package updates to prevent PR noise",
      "groupName": "Serenity/JS packages",
      "matchPackageNames": ["/^@serenity-js//"]
    },
    {
      "description": "Group WebdriverIO package updates to prevent PR noise",
      "groupName": "WebdriverIO packages",
      "matchPackageNames": ["/^@wdio//", "/^webdriverio$/"]
    },
    {
      "description": "Group testing utility package updates",
      "groupName": "Testing Library & Test Helpers",
      "matchPackageNames": [
        "/^@testing-library//",
        "/^jsdom$/",
        "/^fake-indexeddb$/"
      ]
    }
  ]
}
